{
  "name": "aphrody",
  "version": "1.0.0",
  "description": "Unified cross-CLI autonomous engineering plugin: rules, MCP servers, and curated cross-project skills.",
  "contextFileName": "rules/AGENTS.md",
  "mcpServers": {
    "ai-os": {
      "command": "bun",
      "args": ["${extensionPath}/hooks-handlers/ai-os-stdio.ts"],
      "env": {
        "AI_OS_HUB": "0"
      }
    },
    "claude-bridge": {
      "command": "bun",
      "args": ["${extensionPath}/hooks-handlers/bridge-mcp.ts"]
    },
    "hostinger": {
      "type": "http",
      "url": "https://mcp.hostinger.com"
    },
    "ovh-domain": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_domain"
    },
    "ovh-vps": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_vps"
    },
    "ovh-ip": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_ip"
    },
    "ovh-cloud": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_cloud"
    },
    "ovh-cloud-instance": {
      "type": "http",
      "url": "https://mcp.eu.ovhcloud.com/mcp/v1_cloud_instance"
    }
  }
}
