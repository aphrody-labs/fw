{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install --no-env-file \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-update.ts\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install --no-env-file \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install --no-env-file \"${CLAUDE_PLUGIN_ROOT}/hooks/mailbox.ts\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
