# syntax=docker/dockerfile:1.7
# fw on Alpine: static musl build, then a minimal runtime image
FROM rust:1.100-alpine AS builder
# git: .cargo/config.toml fetches git dependencies (the aphrody-labs forks) with the git CLI.
RUN apk add --no-cache musl-dev git
WORKDIR /src
# The root workspace lists members under crates, aphrody, ay, xtask and more, and cargo loads every member manifest;
# .dockerignore (generated by tools/modern-toolchain/check.ts ignore --write) keeps the context to tracked sources.
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --release --locked --target x86_64-unknown-linux-musl -p fw-bin \
    && install -D -s target/x86_64-unknown-linux-musl/release/fw /out/fw

FROM alpine:3.22 AS runtime
RUN apk add --no-cache ca-certificates wget \
    && adduser -D -u 10001 fw
COPY --from=builder /out/fw /usr/local/bin/fw
USER fw
EXPOSE 4380
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:4380/health || exit 1
ENTRYPOINT ["/usr/local/bin/fw"]
CMD ["serve", "0.0.0.0:4380"]
