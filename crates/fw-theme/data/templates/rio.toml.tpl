# fw-theme {{ name }} ({{ mode }}): rio theme. Copy or link to the rio themes directory and select it with `theme = "fw"`.
[colors]
background = "{{ background }}"
foreground = "{{ foreground }}"
cursor = "{{ cursor }}"
vi-cursor = "{{ cursor }}"
tabs = "{{ dark_background }}"
tabs-active = "{{ accent }}"
split = "{{ muted }}"
split-active = "{{ accent }}"
selection-background = "{{ selection_background }}"
selection-foreground = "{{ selection_foreground }}"
search-match-background = "{{ yellow }}"
search-match-foreground = "{{ background }}"
search-focused-match-background = "{{ red }}"
search-focused-match-foreground = "{{ background }}"
hint-background = "{{ accent }}"
hint-foreground = "{{ background }}"
black = "{{ black }}"
red = "{{ red }}"
green = "{{ green }}"
yellow = "{{ yellow }}"
blue = "{{ blue }}"
magenta = "{{ magenta }}"
cyan = "{{ cyan }}"
white = "{{ white }}"
light-black = "{{ bright_black }}"
light-red = "{{ bright_red }}"
light-green = "{{ bright_green }}"
light-yellow = "{{ bright_yellow }}"
light-blue = "{{ bright_blue }}"
light-magenta = "{{ bright_magenta }}"
light-cyan = "{{ bright_cyan }}"
light-white = "{{ bright_white }}"
