# Applied on top of Microsoft/config-wsl of the pinned microsoft/WSL2-Linux-Kernel tag (see build.sh): what the Android
# container needs and the stock WSL2 kernel lacks (CONFIG_ANDROID_BINDER_IPC is not set there). Everything else the guest
# needs (memfd, PSI, user namespaces, overlayfs, erofs, squashfs, dxgkrnl, vsock) is already on in the stock config.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_LOCALVERSION="-microsoft-standard-WSL2-fwa"
