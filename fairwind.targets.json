{
  "$schema": "fairwind.targets.v1",
  "product": "fairwind",
  "agent": {
    "id": "agy",
    "upstreamStrategy": "read-only-signed-upstream",
    "targetDir": "target/agy",
    "manifestPath": "target/manifest.json",
    "historyPath": "target/upgrade-history.jsonl",
    "autoUpgradeCommand": "bun run upgrade"
  },
  "artifacts": {
    "agyNativeLto": {
      "crate": "native/fairwind-agy",
      "buildOutput": "native/fairwind-agy/target/release/agy.exe",
      "buildOutputUnix": "native/fairwind-agy/target/release/agy",
      "targetPath": "target/agy/agy.exe",
      "targetPathUnix": "target/agy/agy",
      "distPath": "dist/agy-aot.exe",
      "distPathUnix": "dist/agy-aot",
      "profile": "rust-fat-lto-aot"
    },
    "fairwindAbiLto": {
      "crate": "native/fairwind-abi",
      "buildOutput": "native/fairwind-abi/target/release/fairwind_abi.dll",
      "buildOutputUnix": "native/fairwind-abi/target/release/libfairwind_abi.so",
      "targetPath": "target/agy/fairwind_abi.dll",
      "targetPathUnix": "target/agy/libfairwind_abi.so",
      "distPath": "dist/fairwind_abi.dll",
      "distPathUnix": "dist/libfairwind_abi.so",
      "profile": "rust-fat-lto-cdylib"
    },
    "fairwindCliAot": {
      "entry": "src/fairwind_cli.ts",
      "targetPath": "target/agy/fairwind.exe",
      "targetPathUnix": "target/agy/fairwind",
      "distPath": "dist/fairwind.exe",
      "distPathUnix": "dist/fairwind",
      "profile": "bun-compile-aot-trim"
    }
  },
  "modules": [
    {
      "id": "native-pe",
      "path": "native/fairwind-pe",
      "kind": "rust-crate",
      "grammar": "rust",
      "gate": "cargo test --manifest-path native/fairwind-pe/Cargo.toml",
      "sampleFile": "core/rs/craft-libs/crates/pe/src/lib.rs",
      "autoUpgrade": true
    },
    {
      "id": "native-sniff",
      "path": "native/fairwind-sniff",
      "kind": "rust-crate",
      "grammar": "rust",
      "gate": "cargo test --manifest-path native/fairwind-sniff/Cargo.toml",
      "sampleFile": "core/rs/craft-libs/crates/sniff/src/lib.rs",
      "autoUpgrade": true
    },
    {
      "id": "native-kernel",
      "path": "native/fairwind-kernel",
      "kind": "rust-kernel-cdylib",
      "grammar": "rust",
      "gate": "cargo test --manifest-path native/fairwind-kernel/Cargo.toml",
      "sampleFile": "native/fairwind-kernel/src/lib.rs",
      "autoUpgrade": true
    },
    {
      "id": "native-world",
      "path": "native/fairwind-world",
      "kind": "rust-nostd-world-model",
      "grammar": "rust",
      "gate": "cargo test --manifest-path native/fairwind-world/Cargo.toml",
      "sampleFile": "native/fairwind-world/src/lib.rs",
      "autoUpgrade": true
    },
    {
      "id": "native-abi",
      "path": "native/fairwind-abi",
      "kind": "rust-cdylib",
      "grammar": "rust",
      "gate": "cargo test --manifest-path native/fairwind-abi/Cargo.toml",
      "sampleFile": "native/fairwind-abi/src/lib.rs",
      "autoUpgrade": true
    },
    {
      "id": "native-agy",
      "path": "native/fairwind-agy",
      "kind": "rust-bin",
      "grammar": "rust",
      "gate": "cargo test --manifest-path native/fairwind-agy/Cargo.toml",
      "sampleFile": "native/fairwind-agy/src/main.rs",
      "autoUpgrade": true
    },
    {
      "id": "fairwind-cli",
      "path": "src",
      "kind": "bun-aot-cli",
      "grammar": "typescript",
      "gate": "bun test tests",
      "sampleFile": "src/fairwind_cli.ts",
      "autoUpgrade": true
    },
    {
      "id": "fairwind-tests",
      "path": "tests",
      "kind": "test-suite",
      "grammar": "typescript",
      "gate": "bun test tests",
      "sampleFile": "tests/fairwind_cli.test.ts",
      "autoUpgrade": true
    },
    {
      "id": "fairwind-plugin",
      "path": "plugin",
      "kind": "antigravity-plugin",
      "grammar": "typescript",
      "gate": "bun src/fairwind_cli.ts plugin status",
      "sampleFile": "plugin/mcp/fairwind-mcp.ts",
      "autoUpgrade": true
    },
    {
      "id": "core-heretic",
      "path": "core/py/heretic",
      "kind": "python-core",
      "grammar": "python",
      "gate": "uvx ruff check .",
      "sampleFile": "core/py/heretic/config.py",
      "autoUpgrade": true
    },
    {
      "id": "core-neon",
      "path": "core/ts/neon",
      "kind": "ts-re-engine",
      "grammar": "typescript",
      "gate": "bun test tests",
      "sampleFile": "core/ts/neon/package.json",
      "autoUpgrade": true
    },
    {
      "id": "core-craft-libs",
      "path": "core/rs/craft-libs",
      "kind": "rust-format-libs",
      "grammar": "rust",
      "gate": "cargo test --manifest-path native/fairwind-pe/Cargo.toml",
      "sampleFile": "core/rs/craft-libs/crates/pe/src/lib.rs",
      "autoUpgrade": true
    },
    {
      "id": "core-craft-anything",
      "path": "core/rs/craft-anything",
      "kind": "rust-re-engine",
      "grammar": "rust",
      "gate": "bun test tests",
      "sampleFile": "core/rs/craft-anything/crates/ai/src/cli_agents/adapters/antigravity.rs",
      "autoUpgrade": true
    },
    {
      "id": "core-auto",
      "path": "core/rs/auto",
      "kind": "rust-auto-core",
      "grammar": "rust",
      "gate": "bun test tests",
      "sampleFile": "core/rs/auto/auto-auth/Cargo.toml",
      "autoUpgrade": true
    },
    {
      "id": "core-tui-test",
      "path": "core/rs/tui-test",
      "kind": "rust-tui-test-workspace",
      "grammar": "rust",
      "gate": "cargo check --manifest-path core/rs/tui-test/Cargo.toml --workspace",
      "sampleFile": "core/rs/tui-test/crates/tui-test/src/lib.rs",
      "autoUpgrade": true
    },
    {
      "id": "core-wta",
      "path": "core/rs/wta",
      "kind": "rust-intelligent-terminal-wta",
      "grammar": "rust",
      "gate": "cargo check --manifest-path core/rs/wta/Cargo.toml",
      "sampleFile": "core/rs/wta/src/main.rs",
      "autoUpgrade": true
    },
    {
      "id": "core-polyglot-lowlevel",
      "path": "core/go/fairwind-go",
      "kind": "polyglot-go-c-cpp-asm-wasm-cuda-wgsl-java-kotlin",
      "grammar": "go",
      "gate": "bun src/fairwind_cli.ts lowlevel verify",
      "sampleFile": "core/go/fairwind-go/main.go",
      "autoUpgrade": true
    },
    {
      "id": "cloud-cloudflare",
      "path": "cloudflare",
      "kind": "cloudflare-edge-os-worker",
      "grammar": "typescript",
      "gate": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc --outdir target/cloudflare-dry-run",
      "sampleFile": "cloudflare/worker.ts",
      "autoUpgrade": true
    },
    {
      "id": "cloud-vercel",
      "path": "vercel",
      "kind": "vercel-fluid-bun1.4",
      "grammar": "typescript",
      "gate": "bun test tests/fairwind_decisions_vercel.test.ts",
      "sampleFile": "vercel/api/fairwind.ts",
      "autoUpgrade": true
    },
    {
      "id": "external-ghidra",
      "path": "packages/ghidra",
      "kind": "external-jvm",
      "grammar": "java",
      "gate": null,
      "sampleFile": null,
      "autoUpgrade": false
    }
  ]
}
