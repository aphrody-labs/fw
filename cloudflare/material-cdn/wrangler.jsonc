{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "material-cdn",
  "main": "worker.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Static assets (icons, sprites, WOFF2 fonts, Rust tables) live in R2: 175k objects, over the 100k-file Workers Static Assets cap.
  "r2_buckets": [{ "binding": "MATERIAL", "bucket_name": "aphrody-material" }],
  "routes": [{ "pattern": "material.aphrody.com", "custom_domain": true }]
}
