{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fairwind-edge",
  "main": "worker.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FAIRWIND_OS",
        "class_name": "FairwindOSAgent"
      }
    ]
  },
  "exports": {
    "FairwindOSAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "FAIRWIND_ENV": "production"
  }
}
