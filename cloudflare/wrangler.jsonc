{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fw-edge",
  "main": "worker.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../crates/fw-proto/ui",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FW_OS",
        "class_name": "FwOSAgent"
      }
    ]
  },
  "exports": {
    "FwOSAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ai": {
    "binding": "AI"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // fw.aphrody.com is canonical; workers.dev stays on for installs that still use the old URL.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "fw.aphrody.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "FW_ENV": "production"
  }
}
