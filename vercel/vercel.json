{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "rewrites": [
    { "source": "/health", "destination": "/api/fw" },
    { "source": "/openapi.json", "destination": "/api/fw?route=/openapi.json" },
    { "source": "/.well-known/agent.json", "destination": "/api/fw?route=/agent.json" },
    { "source": "/v1/models", "destination": "/api/fw?route=/models" },
    { "source": "/v1beta/decisions", "destination": "/api/fw" }
  ]
}
