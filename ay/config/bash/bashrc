# config/bash/bashrc: single config for the bash family (niubash, aysh, Git Bash, brush).
# Installed by tools/shells.ts, which writes the ~/.bashrc, ~/.bash_profile and ~/.niubashrc stubs that source this file.
# Startup: zero forks except the first launch (caches in $AY_SHELL_CACHE).

# --- Shared environment (all modes, including `bash -c -l`): generated by tools/shells.ts into the cache directory ---
_ay_e=${AY_SHELL_CACHE:-$HOME/.cache/shell}/env.sh
[[ -r $_ay_e ]] && . "$_ay_e"
unset _ay_e
: "${AY_SHELL_CACHE:=$HOME/.cache/shell}"
[[ -n ${LANG-} ]] || export LANG=C.UTF-8

# Git Bash (MSYS2 runtime): converts /v, /f, /c... to V:/, F:/, C:/ for native exes. niubash does not do it
# (documented path contract) and brush has no conversion: wrappers limited to Git Bash.
if [[ $BASH == /usr/bin/bash && ( $OSTYPE == cygwin || $OSTYPE == msys ) ]]; then
  for _ay_c in reg sc schtasks taskkill tasklist icacls robocopy netsh bcdedit findstr cmd wmic sfc dism \
    certutil xcopy ipconfig shutdown where powercfg wevtutil auditpol bitsadmin fsutil manage-bde winget; do
    eval "$_ay_c() { MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' command $_ay_c \"\$@\"; }"
  done
  unset _ay_c
fi

# --- Non-interactive (Claude Code, scripts): stop here ---
[[ $- == *i* ]] || return 0
# niubash peut lire ~/.bash_profile puis ~/.niubashrc : une seule passe interactive.
[[ -n ${_AY_BASHRC_I-} ]] && return 0
_AY_BASHRC_I=1

HISTSIZE=50000 HISTFILESIZE=100000 HISTCONTROL=ignoreboth:erasedups
HISTIGNORE='&:ls:ll:bg:fg:exit:history:clear' HISTTIMEFORMAT='%F %T '
shopt -s histappend cmdhist checkwinsize globstar extglob no_empty_cmd_completion 2>/dev/null

# Minimal prompt, no fork: exit code in red if non-zero, folder, $.
PS1='\[\e[31m\]${?#0}\[\e[0m\]\[\e[34m\]\w\[\e[0m\] \$ '
# History shared between sessions: `history -a` is a builtin.
case ";${PROMPT_COMMAND-};" in *"history -a"*) ;; *) PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;; esac

alias ls='eza --icons=auto --group-directories-first' ll='eza -la --git --icons=auto --group-directories-first' lt='eza -T --level=2 --icons=auto'
alias gs='git status -sb' gd='git diff' gl='git log --oneline --graph -20' lg='lazygit' ff='fastfetch'
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
y() { local tmp cwd; tmp="$(mktemp -t "yazi-cwd.XXXXXX")"; yazi "$@" --cwd-file="$tmp"; if cwd="$(cat -- "$tmp" 2>/dev/null)" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then cd -- "$cwd" || return; fi; rm -f -- "$tmp"; }
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --path-separator /'
export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git --path-separator /'

# --- Lazy completion: script loaded on first Tab, cached in $AY_SHELL_CACHE/comp ---
# Written by tools/shells.ts: git = the installed git's contrib completion, bun = `carapace bun bash` (bun has no bash
# generator on Windows). Generated here on first Tab: just = `just --completions bash`, rustup = `rustup completions
# bash rustup`, cargo = <sysroot>/etc/bash_completion.d/cargo (what `rustup completions bash cargo` sources).
_ay_comp_lazy() {
  local c=${1##*[/\\]} f d=$AY_SHELL_CACHE/comp
  c=${c%.exe}
  case $c in
    git | gitk | bun) f=$d/${c/gitk/git}.bash ;;
    just | cargo | rustup)
      f=$d/$c.bash
      if [[ ! -s $f ]]; then
        [[ -d $d ]] || mkdir -p "$d"
        case $c in
          just) just --completions bash >"$f" 2>/dev/null ;;
          rustup) rustup completions bash rustup >"$f" 2>/dev/null ;;
          # Sysroot cargo script without the `command -v cargo … &&` prefix (rejected by the niubash 1.5.0 parser).
          cargo) local s; s=$(rustc --print sysroot 2>/dev/null) &&
            sed -e "/^command -v cargo .*&&\$/d" -e "s/^} &&\$/}/" "$s/etc/bash_completion.d/cargo" >"$f" ;;
        esac
      fi
      ;;
  esac
  complete -r "$c" 2>/dev/null
  [[ -n $f && -r $f ]] && . "$f"
  local spec fn
  spec=$(complete -p "$c" 2>/dev/null) || return 0
  [[ $spec =~ -F\ ([^ ]+) ]] || return 0
  fn=${BASH_REMATCH[1]}
  [[ $fn == _ay_comp_lazy ]] && return 0
  "$fn" "$@"
}
complete -o bashdefault -o default -F _ay_comp_lazy git gitk bun just cargo rustup

# ay (only when an `ay` is on PATH): completion installed by tools/shells.ts into the cache directory.
[[ -r $AY_SHELL_CACHE/ay-completion.bash ]] && . "$AY_SHELL_CACHE/ay-completion.bash"

# --- zoxide 0.10 + fzf 0.75: init scripts generated once (fork) then sourced (regenerate: rm "$AY_SHELL_CACHE"/bash-*.bash).
# No `command -v` at each startup (PATH scan: ~4 ms each measured under Git Bash): the cache is authoritative.
_ay_c=$AY_SHELL_CACHE/bash-zoxide.bash
if [[ ! -s $_ay_c ]] && command -v zoxide >/dev/null; then
  [[ -d $AY_SHELL_CACHE ]] || mkdir -p "$AY_SHELL_CACHE"
  # Removes the init's two command substitutions (forks at load).
  zoxide init bash | sed -e 's|^__zoxide_oldpwd="\$(__zoxide_pwd)"$|__zoxide_oldpwd=$PWD|' \
    -e 's|\[\[ "\$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"\* \]\]|[[ ${PROMPT_COMMAND@a} == *a* ]]|' >"$_ay_c"
fi
if [[ -s $_ay_c ]]; then
  . "$_ay_c"
  # zoxide (Windows) expects C:\x: conversion of /c/x or C:/x in pure bash (no cygpath), added only after cd.
  __zoxide_wpath() {
    __zoxide_wp=$PWD
    if [[ $__zoxide_wp =~ ^/([a-zA-Z])(/.*)?$ ]]; then __zoxide_wp="${BASH_REMATCH[1]^^}:${BASH_REMATCH[2]:-/}"; fi
    __zoxide_wp=${__zoxide_wp//\//\\}
  }
  __zoxide_pwd() { __zoxide_wpath; \builtin printf '%s\n' "$__zoxide_wp"; }
  __zoxide_hook() {
    \builtin local -r retval="$?"
    if [[ $__zoxide_oldpwd != "$PWD" ]]; then
      __zoxide_oldpwd=$PWD
      [[ -o history ]] && { __zoxide_wpath; \command zoxide add -- "$__zoxide_wp"; }
    fi
    return "$retval"
  }
fi
# fzf: Ctrl-R, Ctrl-T, Alt-C (`bind -x`). The script's `command -v perl` test (~7 ms) is frozen to false: awk branch.
# Each bind is kept for the active editing mode only: niubash reports every bind aimed at another keymap.
_ay_c=$AY_SHELL_CACHE/bash-fzf.bash
if [[ ! -s $_ay_c ]] && command -v fzf >/dev/null; then
  [[ -d $AY_SHELL_CACHE ]] || mkdir -p "$AY_SHELL_CACHE"
  fzf --bash 2>/dev/null | sed -n -e 's/^if command -v perl > \/dev\/null; then$/if false; then/' \
    -e 's/^\( *\)bind -m vi-command /\1[[ -o vi ]] \&\& bind -m vi-command /' \
    -e 's/^\( *\)bind -m vi-insert /\1[[ -o vi ]] \&\& bind -m vi-insert /' \
    -e 's/^\( *\)bind -m emacs-standard /\1[[ -o vi ]] || bind -m emacs-standard /' \
    -e '1,/^### end: key-bindings.bash ###/p' >"$_ay_c"
fi
[[ -s $_ay_c ]] && . "$_ay_c"
# starship + atuin: cached inits (zero forks after first launch; brush skips if unsupported).
if [[ -z ${BRUSH_VERSION-} ]]; then
  # scan_timeout stays short (starship.toml) for a fast prompt in large directories such as $HOME; the
  # "Scanning current directory timed out" warning that follows is noise, so only errors are logged.
  export STARSHIP_LOG=error
  _ay_c=$AY_SHELL_CACHE/bash-starship.bash
  if [[ ! -s $_ay_c ]] && command -v starship >/dev/null; then
    [[ -d $AY_SHELL_CACHE ]] || mkdir -p "$AY_SHELL_CACHE"
    # niubash 1.5.0 reads STARSHIP_START_TIME as 0 in a bare-name arithmetic (`$((END - START))`) once PS0 has set it,
    # so every prompt showed the epoch as the command duration; expanding the values works.
    starship init bash --print-full-init 2>/dev/null |
      sed 's|STARSHIP_DURATION=\$((STARSHIP_END_TIME - STARSHIP_START_TIME))|STARSHIP_DURATION=$((${STARSHIP_END_TIME} - ${STARSHIP_START_TIME}))|' >"$_ay_c"
  fi
  [[ -s $_ay_c ]] && . "$_ay_c"
  _ay_c=$AY_SHELL_CACHE/bash-atuin.bash
  if [[ ! -s $_ay_c ]] && command -v atuin >/dev/null; then
    [[ -d $AY_SHELL_CACHE ]] || mkdir -p "$AY_SHELL_CACHE"
    # The ble.sh integration declares `function ble/complete/...:atuin-history {` inside a function; niubash
    # rejects that name ("unexpected end of file from `{'"), and ble.sh is not loaded here: the hook becomes a no-op.
    # Atuin binds every keymap (emacs, vi-insert, vi-command); niubash reports each bind aimed at a keymap the
    # session does not use. The keymaps follow the active editing mode, read when the cache is sourced.
    atuin init bash --disable-up-arrow 2>/dev/null |
      awk 'NR == 1 { print "[[ -o vi ]] && __ay_keymaps=\"vi-insert vi-command\" || __ay_keymaps=emacs" }
        /^__atuin_initialize_blesh\(\) \{/ { print "__atuin_initialize_blesh() { :; }"; skip = 1; next }
        skip && /^}$/ { skip = 0; next }
        skip { next }
        { gsub(/for __atuin_keymap in emacs vi-insert vi-command;/, "for __atuin_keymap in $__ay_keymaps;") }
        match($0, /^[ \t]*(atuin-bind|bind) -m (emacs|vi-insert|vi-command)[ \t]/) {
          km = $0; sub(/^[ \t]*(atuin-bind|bind) -m /, "", km); sub(/[ \t].*/, "", km)
          print "[[ \" $__ay_keymaps \" == *\" " km " \"* ]] && " $0; next }
        { print }' >"$_ay_c"
  fi
  [[ -s $_ay_c ]] && . "$_ay_c"
fi
unset _ay_c
