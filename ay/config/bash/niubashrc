# config/bash/niubashrc: niubash 1.5 in interactive mode reads only ~/.niubashrc ("On Windows, configuration is ONE
# file"): the shared bashrc is re-plugged here.
# "/" = NIU_ROOT; a /<path> missing from NIU_ROOT falls back to the system drive (cd /src -> C:\src).
export NIU_ROOT_FALLBACK=1
. "${BASH_SOURCE[0]%[/\\]*}/bashrc"
