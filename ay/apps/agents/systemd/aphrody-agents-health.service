# Repairs the tmux session/windows, requeues orphan tasks, probes CLIs, ships logs to <prod-host>.
[Unit]
Description=Aphrody agent runner health check

[Service]
Type=oneshot
KillMode=process
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=AY_ROOT=@SRC@
ExecStart=@BUN@ --no-env-file @SRC@/apps/agents/runner.ts health
