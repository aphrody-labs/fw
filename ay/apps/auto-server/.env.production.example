# Copier vers .env.production ; ne jamais versionner les secrets.
# Seules les variables lues par apps/auto-server et crates/auto-sdk figurent ici.

# Obligatoire en production : au moins 32 caractères, ou 32 octets en base64 (packages/auto-store/src/auth/crypto.ts).
AUTO_MASTER_KEY=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum
AUTO_URL_APP=https://auto.exemple.fr
AUTO_HOST=127.0.0.1
AUTO_PORT=3001
AUTO_DB_PATH=data/auto.sqlite
AUTO_DATA_DIR=data
