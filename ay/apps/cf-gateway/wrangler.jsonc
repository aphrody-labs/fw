{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ay-cf-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "aphrody-assets"
    },
    {
      "binding": "VIDEO",
      "bucket_name": "aphrody-video"
    },
  ]
}
