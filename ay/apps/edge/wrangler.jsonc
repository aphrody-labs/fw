{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ay-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "aphrody-releases"
    },
    {
      "binding": "ASSETS",
      "bucket_name": "aphrody-assets"
    },
    {
      "binding": "VIDEO",
      "bucket_name": "aphrody-video"
    },
    {
      "binding": "CHROMIUM",
      "bucket_name": "aphrody-chromium"
    },
    {
      "binding": "DIST",
      "bucket_name": "aphrody-dist"
    },
    {
      "binding": "BUN_LIB",
      "bucket_name": "bun-lib"
    }
  ],
  "services": [
    {
      "binding": "SVC_LEARN",
      "service": "aphrody-learn"
    },
    {
      "binding": "SVC_APHRODY",
      "service": "aphrody-worker"
    },
    {
      "binding": "SVC_AUTO",
      "service": "auto"
    },
    {
      "binding": "SVC_SHENRON_CDN",
      "service": "shenron-cdn"
    }
  ],
  "vars": {
    "EDGE_SERVICES": {
      "releases": {
        "binding": null
      },
      "assets": {
        "binding": null
      },
      "wasm": {
        "binding": null
      },
      "learn": {
        "binding": "SVC_LEARN"
      },
      "aphrody": {
        "binding": "SVC_APHRODY"
      },
      "auto": {
        "binding": "SVC_AUTO"
      },
      "shenron": {
        "binding": "SVC_SHENRON_CDN"
      },
      "bucket": {
        "binding": null
      }
    },
    "EDGE_STORES": {
      "ASSETS": {
        "binding": "ASSETS",
        "allow": [
          "index.html",
          "manifest.json",
          "brand/",
          "craft/",
          "craft-captures/",
          "game/",
          "gamescope/",
          "m3/",
          "manifests/",
          "objects/",
          "pet/",
          "sha256/",
          "v1/",
          "web/",
          "webos/"
        ]
      },
      "RELEASES": {
        "binding": "RELEASES"
      },
      "VIDEO": {
        "binding": "VIDEO"
      },
      "CHROMIUM": {
        "binding": "CHROMIUM"
      },
      "DIST": {
        "binding": "DIST"
      },
      "BUN_LIB": {
        "binding": "BUN_LIB"
      }
    },
    "EDGE_BUCKETS": {
      "assets.aphrody.app": {
        "bucket": "ASSETS",
        "cors": "assets"
      },
      "video.aphrody.app": {
        "bucket": "VIDEO",
        "cors": "video"
      },
      "dist.aphrody.app": {
        "bucket": "DIST",
        "cors": "read"
      },
      "bun-lib.aphrody.app": {
        "bucket": "BUN_LIB"
      }
    },
    "EDGE_CORS": {
      "assets": {
        "origins": [
          "https://aphrody.app",
          "https://www.aphrody.app",
          "https://aphrody.com",
          "https://dragonballfr.com",
          "https://www.dragonballfr.com",
          "https://app-video.aphrody.app",
          "https://app-generation.aphrody.app",
          "https://app-images.aphrody.app",
          "https://app-vectors.aphrody.app",
          "https://app-compositing.aphrody.app",
          "https://app-photo-processing.aphrody.app",
          "https://app-pdf.aphrody.app",
          "https://app-documents.aphrody.app",
          "https://app-audio.aphrody.app",
          "https://app-layout.aphrody.app",
          "https://app-cad.aphrody.app",
          "https://app-slides.aphrody.app",
          "https://app-tables.aphrody.app",
          "https://app-interface-layouts.aphrody.app"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range",
          "If-None-Match"
        ],
        "expose": [
          "ETag",
          "Content-Length",
          "Content-Range",
          "Accept-Ranges"
        ],
        "max_age": 86400
      },
      "video": {
        "origins": [
          "https://aphrody.app",
          "https://www.aphrody.app",
          "https://aphrody.com",
          "https://www.aphrody.com",
          "https://video.aphrody.app",
          "https://video.aphrody.com"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range",
          "Content-Type",
          "Origin",
          "Accept"
        ],
        "expose": [
          "Accept-Ranges",
          "Content-Length",
          "Content-Range",
          "Content-Type",
          "ETag"
        ],
        "max_age": 86400
      },
      "read": {
        "origins": [
          "https://aphrody.app",
          "https://www.aphrody.app",
          "https://aphrody.com",
          "https://dragonballfr.com",
          "https://www.dragonballfr.com"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range",
          "If-None-Match"
        ],
        "expose": [
          "ETag",
          "Content-Length",
          "Content-Range",
          "Accept-Ranges"
        ],
        "max_age": 86400
      }
    },
    "EDGE_ROUTES": [
      {
        "pattern": "releases.aphrody.com/*",
        "host": "releases.aphrody.com",
        "path": "/",
        "prefix": true,
        "service": "releases"
      },
      {
        "pattern": "downloads.aphrody.com/*",
        "host": "downloads.aphrody.com",
        "path": "/",
        "prefix": true,
        "service": "releases"
      },
      {
        "pattern": "aphrody.com/download*",
        "host": "aphrody.com",
        "path": "/download",
        "prefix": true,
        "service": "releases",
        "hints": {
          "early_hints": [
            "</brand/icon.svg>; rel=preload; as=image"
          ]
        }
      },
      {
        "pattern": "assets.aphrody.com/*",
        "host": "assets.aphrody.com",
        "path": "/",
        "prefix": true,
        "service": "assets"
      },
      {
        "pattern": "aphrody.com/r2-assets/*",
        "host": "aphrody.com",
        "path": "/r2-assets/",
        "prefix": true,
        "service": "assets"
      },
      {
        "pattern": "wasm.aphrody.com/*",
        "host": "wasm.aphrody.com",
        "path": "/",
        "prefix": true,
        "service": "wasm"
      },
      {
        "pattern": "learn.aphrody.com/*",
        "host": "learn.aphrody.com",
        "path": "/",
        "prefix": true,
        "service": "learn"
      },
      {
        "pattern": "docs.aphrody.com/*",
        "host": "docs.aphrody.com",
        "path": "/",
        "prefix": true,
        "service": "aphrody",
        "hints": {
          "cache": {
            "ttl": 300,
            "swr": 3600
          }
        }
      },
      {
        "pattern": "aphrody.com/github",
        "host": "aphrody.com",
        "path": "/github",
        "prefix": false,
        "service": "aphrody"
      },
      {
        "pattern": "auto.aphrody.com/*",
        "host": "auto.aphrody.com",
        "path": "/",
        "prefix": true,
        "service": "auto"
      },
      {
        "pattern": "cdn.dragonballfr.com/*",
        "host": "cdn.dragonballfr.com",
        "path": "/",
        "prefix": true,
        "service": "shenron",
        "hints": {
          "cache": {
            "ttl": 3600,
            "swr": 86400
          }
        }
      },
      {
        "pattern": "assets.aphrody.app/*",
        "host": "assets.aphrody.app",
        "path": "/",
        "prefix": true,
        "service": "bucket"
      },
      {
        "pattern": "video.aphrody.app/*",
        "host": "video.aphrody.app",
        "path": "/",
        "prefix": true,
        "service": "bucket"
      },
      {
        "pattern": "dist.aphrody.app/*",
        "host": "dist.aphrody.app",
        "path": "/",
        "prefix": true,
        "service": "bucket"
      },
      {
        "pattern": "bun-lib.aphrody.app/*",
        "host": "bun-lib.aphrody.app",
        "path": "/",
        "prefix": true,
        "service": "bucket"
      }
    ]
  },
  "routes": [
    {
      "pattern": "releases.aphrody.com/*",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "downloads.aphrody.com/*",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "aphrody.com/download*",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "assets.aphrody.com/*",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "aphrody.com/r2-assets/*",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "wasm.aphrody.com/*",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "learn.aphrody.com/*",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "docs.aphrody.com/*",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "aphrody.com/github",
      "zone_name": "aphrody.com"
    },
    {
      "pattern": "auto.aphrody.com",
      "custom_domain": true
    },
    {
      "pattern": "cdn.dragonballfr.com/*",
      "zone_name": "dragonballfr.com"
    },
    {
      "pattern": "assets.aphrody.app/*",
      "zone_name": "aphrody.app"
    },
    {
      "pattern": "video.aphrody.app/*",
      "zone_name": "aphrody.app"
    },
    {
      "pattern": "dist.aphrody.app/*",
      "zone_name": "aphrody.app"
    },
    {
      "pattern": "bun-lib.aphrody.app/*",
      "zone_name": "aphrody.app"
    }
  ]
}
