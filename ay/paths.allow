# Absolute-path literals that are allowed, one repo-relative glob per line (tools/paths.ts).
ay.toml                       # the host layout table: [paths.<role>] is the one place host paths are written
tools/paths.test.ts           # fixtures of the checker itself
tools/disks.test.ts           # df output fixture of the fleet
docs/spec.md                  # being edited by the standard workflow; replace the build work path with [paths.build].work after it lands
