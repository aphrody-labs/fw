From 661432aa5ba2aad100ce6af507de01380820be5c Mon Sep 17 00:00:00 2001
From: aphrody-dev <324927936+aphrody-dev@users.noreply.github.com>
Date: Tue, 17 Nov 2026 04:10:51 +0000
Subject: [PATCH] fix(large_stack_arrays): don't lint arrays in associated
 consts

Arrays in associated consts (inherent, trait default and trait impl)
were linted, although the same arrays in a free const or a static are
not. Their value is evaluated at compile time and takes no stack frame.

Fixes #18066

changelog: [`large_stack_arrays`]: No longer lints arrays in associated consts
---
 clippy_lints/src/large_stack_arrays.rs |  8 +++++++-
 tests/ui/large_stack_arrays.rs         | 16 ++++++++++++++++
 tests/ui/large_stack_arrays.stderr     | 24 ++++++++++++------------
 3 files changed, 35 insertions(+), 13 deletions(-)

diff --git a/clippy_lints/src/large_stack_arrays.rs b/clippy_lints/src/large_stack_arrays.rs
index 49d4fe478..cda54f377 100644
--- a/clippy_lints/src/large_stack_arrays.rs
+++ b/clippy_lints/src/large_stack_arrays.rs
@@ -5,7 +5,7 @@ use clippy_utils::diagnostics::span_lint_and_then;
 use clippy_utils::macros::macro_backtrace;
 use clippy_utils::source::snippet;
 use clippy_utils::{is_from_proc_macro, sym};
-use rustc_hir::{Expr, ExprKind, Item, ItemKind, Node};
+use rustc_hir::{Expr, ExprKind, ImplItem, ImplItemKind, Item, ItemKind, Node, TraitItem, TraitItemKind};
 use rustc_lint::{LateContext, LateLintPass, impl_lint_pass};
 use rustc_middle::ty;
 use rustc_middle::ty::layout::LayoutOf as _;
@@ -88,6 +88,12 @@ impl<'tcx> LateLintPass<'tcx> for LargeStackArrays {
                     Node::Item(Item {
                         kind: ItemKind::Static(..),
                         ..
+                    }) | Node::ImplItem(ImplItem {
+                        kind: ImplItemKind::Const(..),
+                        ..
+                    }) | Node::TraitItem(TraitItem {
+                        kind: TraitItemKind::Const(..),
+                        ..
                     })
                 )
             })
diff --git a/tests/ui/large_stack_arrays.rs b/tests/ui/large_stack_arrays.rs
index d9643493e..5701d1aff 100644
--- a/tests/ui/large_stack_arrays.rs
+++ b/tests/ui/large_stack_arrays.rs
@@ -21,6 +21,22 @@ const STATIC_PROMOTED_LARGE_ARRAY_WITH_NESTED: &[u8; 512001] = {
     &[0; 512001]
 };
 
+struct Holder;
+
+impl Holder {
+    const INHERENT_LITERAL: &'static [u32] = &[0; 5000];
+    const INHERENT_REPEAT: &'static [u32] = &[7; 5000];
+}
+
+trait Listed {
+    const TRAIT_DEFAULT: &'static [u8] = &[0; 20_000];
+    const TRAIT_REQUIRED: &'static [u8];
+}
+
+impl Listed for Holder {
+    const TRAIT_REQUIRED: &'static [u8] = &[1; 20_000];
+}
+
 pub static DOESNOTLINT: [u8; 512_001] = [0; 512_001];
 pub static DOESNOTLINT2: [u8; 512_001] = {
     let x = 0;
