{
  "name": "ay",
  "private": true,
  "type": "module",
  "bin": {
    "ay": "./apps/ay/src/cli.ts"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/env-kit/*",
      "apps/*"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "features": "bun tools/features.ts",
    "abi": "bun tools/abi.ts",
    "submodules": "bun tools/submodules.ts",
    "deploy": "bun tools/deploy.ts",
    "sessions": "bun tools/claude-sessions.ts",
    "map": "bun tools/map.ts",
    "check": "bun tools/features.ts --check && bun tools/submodules.ts --check && bun tools/paths.ts && bun tools/private-gate.ts && bun tools/abi.ts --check && bun tools/tokens-compose.ts --check && bun tools/edge-config.ts --check && bun check --no-script && bun test ./tools/ ./packages/org-mirror ./packages/edge-stack ./apps/ay ./packages/cf-control-plane ./apps/cf-gateway ./apps/tools-release ./apps/edge packages/auto- apps/auto-",
    "cf:audit": "bun tools/cf-audit.ts",
    "auto:server": "bun apps/auto-server/src/bin.ts",
    "auto:dev": "bun --watch apps/auto-server/src/bin.ts",
    "auto:migrate": "bun packages/auto-store/src/migrate.ts",
    "auto:openapi": "bun tools/auto-openapi.ts",
    "auto:build-native": "bun tools/auto-build-native.ts",
    "auto:build-aot": "bun tools/auto-build-aot.ts",
    "auto:validate-facturx": "bun tools/auto-validate-facturx.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "web-tree-sitter": "0.27.2"
  },
  "patchedDependencies": {
    "jsonc-parser@3.3.1": "patches/jsonc-parser@3.3.1.patch"
  }
}
