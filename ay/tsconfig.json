{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@aphrody/ay-chromium-releases": [
        "./packages/chromium-releases/src/index.ts"
      ],
      "@aphrody/*": [
        "./packages/*/src/index.ts"
      ]
    },
    "types": [
      "bun"
    ]
  }
}
