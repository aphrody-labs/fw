  "constants": [
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_VERSION",
      "value": 0,
      "nargs": 0,
      "doc": "() -> abi version"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_YIELD",
      "value": 1,
      "nargs": 0,
      "doc": "() -> 0"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_LOG",
      "value": 2,
      "nargs": 3,
      "doc": "(console cap, packed bytes, len 1..4) -> len; bytes little-endian"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_MSG_SET",
      "value": 3,
      "nargs": 2,
      "doc": "(register 0..3, value) -> 0"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_MSG_GET",
      "value": 4,
      "nargs": 1,
      "doc": "(register 0..3) -> value"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_SEND",
      "value": 5,
      "nargs": 1,
      "doc": "(endpoint cap) -> 0; sends the four message registers"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_RECV",
      "value": 6,
      "nargs": 1,
      "doc": "(endpoint cap) -> 0; fills the four message registers"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_CAP_DERIVE",
      "value": 7,
      "nargs": 2,
      "doc": "(cap, rights mask) -> new handle with rights & mask; needs AY_RIGHT_DERIVE"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_CAP_DROP",
      "value": 8,
      "nargs": 1,
      "doc": "(cap) -> 0"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_FRAME_ALLOC",
      "value": 9,
      "nargs": 0,
      "doc": "() -> frame number"
    },
    {
      "group": "syscall",
      "type": "u32",
      "name": "AY_SYS_FRAME_FREE",
      "value": 10,
      "nargs": 1,
      "doc": "(frame) -> 0; only the owner may free"
    },
    {
      "group": "error",
      "type": "i32",
      "name": "AY_EPERM",
      "value": -1,
      "doc": "capability lacks the right, or the object is not yours"
