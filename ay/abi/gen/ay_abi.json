    {
      "group": "error",
      "type": "i32",
      "name": "AY_EBADCAP",
      "value": -2,
      "doc": "no such handle, or the wrong kind of object"
    },
    {
      "group": "error",
      "type": "i32",
      "name": "AY_EINVAL",
      "value": -3,
