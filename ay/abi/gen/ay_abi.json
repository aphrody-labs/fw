    },
    {
      "group": "error",
      "type": "i32",
      "name": "AY_EAGAIN",
      "value": -4,
      "doc": "queue full or empty"
    },
    {
      "group": "error",
      "type": "i32",
      "name": "AY_ENOMEM",
      "value": -5,
      "doc": "table or frame pool exhausted"
    },
    {
      "group": "error",
      "type": "i32",
      "name": "AY_ENOSYS",
      "value": -6,
      "doc": "unknown syscall number"
    },
    {
      "group": "right",
      "type": "u32",
      "name": "AY_RIGHT_SEND",
      "value": 1
    },
    {
      "group": "right",
      "type": "u32",
      "name": "AY_RIGHT_RECV",
      "value": 2
    },
    {
      "group": "right",
      "type": "u32",
      "name": "AY_RIGHT_DERIVE",
      "value": 4
    },
    {
      "group": "misc",
      "type": "u32",
      "name": "AY_ABI_VERSION",
      "value": 1
    },
    {
      "group": "misc",
      "type": "u32",
      "name": "AY_MSG_WORDS",
      "value": 4
    }
  ],
  "functions": [
    {
      "name": "ay_syscall",
      "returns": "i32",
      "params": [
        [
          "nr",
          "u32"
        ],
        [
          "a0",
          "u32"
        ],
        [
          "a1",
          "u32"
        ],
        [
          "a2",
          "u32"
        ]
      ],
      "import": {
        "module": "ay",
        "name": "syscall"
      },
      "doc": "The one entry point."
    },
    {
      "name": "ay_abi_version",
      "returns": "u32",
      "params": [],
      "doc": "The ABI version the library implements."
    },
    {
      "name": "ay_rights_allow",
      "returns": "u32",
      "params": [
        [
          "have",
          "u32"
        ],
        [
          "need",
          "u32"
        ]
      ],
      "doc": "1 when a capability holding `have` may do an operation that needs `need`, else 0."
    },
    {
      "name": "ay_arg_count",
      "returns": "u32",
      "params": [
        [
          "nr",
          "u32"
        ]
      ],
      "doc": "Number of arguments syscall `nr` reads; 0 for an unknown number."
    },
    {
      "name": "ay_first_free",
      "returns": "i32",
      "params": [
        [
          "bits",
          "u64"
        ]
      ],
      "doc": "Index of the lowest clear bit, or -1 when all 64 are set: the first free frame."
    },
    {
      "name": "ay_checksum",
      "returns": "u32",
      "params": [
        [
          "words",
          "*const u32"
        ],
        [
          "len",
          "usize"
        ]
      ],
      "doc": "Rotate-and-add checksum of a message of `len` words."
    },
    {
      "name": "ay_sum",
      "returns": "u32",
      "params": [
        [
          "words",
          "*const u32"
        ],
        [
          "len",
          "usize"
        ]
      ],
      "doc": "Wrapping sum of `len` words."
    },
    {
      "name": "ay_try_acquire",
      "returns": "u32",
      "params": [
        [
          "flag",
          "*mut u32"
        ]
      ],
      "doc": "Take the lock word 0 -> 1: 1 when this caller now holds it, else 0."
    }
  ]
}
