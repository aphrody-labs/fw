{
  // Organization baseline (STANDARD.md section 3). Tables, long lines and inline HTML are normal in READMEs.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD034": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD036": false,
    "MD060": false
  },
  "ignores": ["node_modules/**", "third_party/**"]
}
