{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "fairwind",
  "owner": { "name": "aphrody-labs", "url": "https://github.com/aphrody-labs" },
  "metadata": { "description": "Fairwind plugin for Claude Code, from the same plugin/ directory agy installs.", "version": "2.3.0" },
  "plugins": [
    {
      "name": "fairwind",
      "source": "./plugin",
      "strict": false,
      "description": "Fairwind CLI, MCP, agy-knowledge, binary analysis, reverse engineering, tree-sitter, Rust brain.",
      "version": "2.3.0",
      "author": { "name": "aphrody-labs", "url": "https://github.com/aphrody-labs" },
      "homepage": "https://github.com/aphrody-labs/fairwind",
      "skills": "./skills/",
      "mcpServers": {
        "fairwind": {
          "command": "bun",
          "args": ["--no-install", "--no-env-file", "${CLAUDE_PLUGIN_ROOT}/mcp/fairwind-mcp.ts"]
        }
      }
    }
  ]
}
