{
  "name": "@aphrody/mcp-ui",
  "version": "7.1.1-aphrody.1",
  "description": "MCP interactive app client with sandbox readiness and cancellation fixes.",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --target browser --packages external --outdir dist && tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist/types --rootDir src",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": "aphrody-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/mcp-ui.git"
  },
  "license": "Apache-2.0",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "tsconfig.json",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test-setup.ts",
    "dist",
    "UPSTREAM.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
