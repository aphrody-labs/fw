# Maintainer: Aphrody Labs <dev@aphrody.com>
# Alpine Linux edge/community uutils-coreutils-compatible static musl multicall recipe
pkgname=fw-uutils-os
pkgver=4.0.0
pkgrel=0
pkgdesc="fw static musl multicall binary (uutils applets, NixOS store paths)"
url="https://github.com/aphrody-labs/fw"
arch="x86_64 aarch64 riscv64"
license="MIT"
makedepends="cargo rust"
provides="uutils-coreutils fw"
options="net !check"

build() {
	RUSTFLAGS="-C target-feature=+crt-static" \
		cargo build --release --locked --target "${CARCH}-unknown-linux-musl" -p fw-bin
}

package() {
	install -Dm755 "target/${CARCH}-unknown-linux-musl/release/fw" \
		"$pkgdir/usr/bin/fw"
	for applet in ls cat echo wc head tail sha256sum uname env pwd stat find grep diff sed ps hostname; do
		ln -s /usr/bin/fw "$pkgdir/usr/bin/$applet"
	done
}
