# Fairwind Zero-Legacy WSL2 Kernel Fragment (base: linux-msft-wsl-6.18.58.1 + CachyOS BORE + sched_ext)
# Strips legacy Plan 9 (9p), CIFS, ZSWAP, and legacy C filesystems; enables Rust-era virtio-fs, virtio-vsock,
# CachyOS BORE + sched_ext (scx_lavd/scx_rustland), Clang ThinLTO, dxgkrnl (RTX 4070), XFS, ZRAM zstd, MGLRU, BBR.

# --- REMOVED LEGACY WSL BLOAT ---
# CONFIG_9P_FS is not set
# CONFIG_9P_FS_POSIX_ACL is not set
# CONFIG_CIFS is not set
# CONFIG_ZSWAP is not set

# --- COMPILER & LTO (CachyOS Clang + ThinLTO + x86_64-v3) ---
CONFIG_LTO_CLANG_THIN=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_X86_64_VERSION=3
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y

# --- CACHYOS BORE + RUST SCHED_EXT (scx_lavd / scx_rustland) ---
CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y

# --- MODERN VIRTIO + MICROSOFT GPU-PV (RTX 4070 CUDA/Vulkan/WebGPU) ---
CONFIG_DXGKRNL=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU=y

# --- MEMORY: ZRAM ZSTD + MGLRU + THP MADVISE ---
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- STORAGE: XFS REFLINK + BTRFS + IO_URING ---
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_IO_URING=y

# --- NETWORKING: BBR + FQ + WIREGUARD ---
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_WIREGUARD=y
CONFIG_NFT_COMPAT=y

# --- NESTED VIRTUALIZATION (OpenVMM / Cloud-Hypervisor / Asterinas OSDK) ---
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
