# Fairwind Custom WSL2 Kernel Fragment (base: microsoft/WSL2-Linux-Kernel linux-msft-wsl-6.18.58.1)
# Fuses: Microsoft dxgkrnl (RTX 4070 CUDA/Vulkan/D3D12) + CachyOS BORE/sched_ext + Clang ThinLTO + XFS/ZRAM/MGLRU/BBR

# Compiler & LTO (Clang + ThinLTO + x86_64-v3)
CONFIG_LTO_CLANG_THIN=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_X86_64_VERSION=3
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y

# CachyOS schedulers: BORE + sched_ext (BPF extensible scheduler)
CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y

# Microsoft WSL2 GPU-PV (NVIDIA RTX 4070 CUDA / Direct3D12 / Vulkan / WebGPU)
CONFIG_DXGKRNL=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_VIRTIO_FS=y
CONFIG_9P_FS=y

# Memory, ZRAM zstd, MGLRU, THP madvise (no double-compression zswap)
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=n
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Filesystems (XFS reflink + Btrfs + OverlayFS + io_uring)
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_IO_URING=y

# Networking (BBR + FQ + WireGuard + Mirrored WSL 3.0.5)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_WIREGUARD=y
CONFIG_NFT_COMPAT=y

# Nested virtualization for Asterinas OSDK / NixOS VM tests
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
